{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mahaffey-pickem-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "POOL_PASSWORD": "Mutiny",
    "FRONTEND_ORIGIN": "https://mahaf027.github.io",
    "SESSION_DAYS": "90",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahaffey-pickem",
      "database_id": "dfc03e22-632f-4973-a239-721768be9f6f",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
}
